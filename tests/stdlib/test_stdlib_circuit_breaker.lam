# Test: CircuitBreaker — closed -> open -> half-open -> closed cycle.
# expect: state-initial: closed
# expect: ok-call: ok
# expect: state-after-success: closed
# expect: state-after-trip: open
# expect: open-blocks: blocked
# expect: state-after-cooldown: half-open
# expect: state-after-recovery: closed

from @lam/vulture/std-plugin import CircuitBreaker
from lamerrors import Result
from lamtime import Time

func goodFn() {
    pass
}

func failingFn() {
    go! {
        panic("downstream error")
    }
}

func main() {
    cb: CircuitBreaker = CircuitBreaker(2, 100)
    print(f"state-initial: {cb.state()}")
    success: Result = cb.call(goodFn)
    if success.ok() {
        print("ok-call: ok")
    } else {
        print("ok-call: FAIL")
    }
    print(f"state-after-success: {cb.state()}")
    _ = cb.call(failingFn)
    _ = cb.call(failingFn)
    print(f"state-after-trip: {cb.state()}")
    blocked: Result = cb.call(goodFn)
    if not blocked.ok() {
        print("open-blocks: blocked")
    } else {
        print("open-blocks: NOT BLOCKED")
    }
    Time.sleepMs(150)
    print(f"state-after-cooldown: {cb.state()}")
    _ = cb.call(goodFn)
    print(f"state-after-recovery: {cb.state()}")
}

# Test: @lam/vulture/std-plugin tracing — W3C Trace Context propagation.
# expect: fresh-echo-has-tp: true
# expect: fresh-tp-format-ok: true
# expect: fresh-trace-len: 32
# expect: fresh-span-len: 16
# expect: inbound-same-trace: true
# expect: inbound-new-span: true
# expect: state-propagated: vendor=abc
# expect: echo-off-no-header: true

from @lam/vulture import Server, Request, Response, InjectResponse
from @lam/vulture/std-plugin import tracing

go! {
    import (
        "strings"
    )
}

func traceDump(req: Request, res: Response) {
    tp: str = ""
    tid: str = ""
    sid: str = ""
    go! {
        if value, ok := req.Ctx.Get("__lamTraceParent", nil).(string); ok {
            tp = value
        }
        if value, ok := req.Ctx.Get("__lamTraceId", nil).(string); ok {
            tid = value
        }
        if value, ok := req.Ctx.Get("__lamSpanId", nil).(string); ok {
            sid = value
        }
    }
    res.text(f"{tp}|{tid}|{sid}")
}

func main() {
    srv: Server = Server()
    tracing(srv)
    srv.get("/t", traceDump)
    r1: InjectResponse = srv.inject("GET", "/t")
    echoedTp: str = r1.header("traceparent")
    print(f"fresh-echo-has-tp: {echoedTp != ''}")

    formatOk: bool = false
    tidLen: int = 0
    sidLen: int = 0
    go! {
        parts := strings.Split(echoedTp, "-")
        if len(parts) == 4 && parts[0] == "00" && parts[3] == "01" {
            formatOk = true
            tidLen = len(parts[1])
            sidLen = len(parts[2])
        }
    }
    print(f"fresh-tp-format-ok: {formatOk}")
    print(f"fresh-trace-len: {tidLen}")
    print(f"fresh-span-len: {sidLen}")

    inboundTid: str = "4bf92f3577b34da6a3ce929d0e0e4736"
    inboundSid: str = "00f067aa0ba902b7"
    inboundTp: str = f"00-{inboundTid}-{inboundSid}-01"
    hdrs: dict[str, str] = {"traceparent": inboundTp, "tracestate": "vendor=abc"}
    r2: InjectResponse = srv.inject("GET", "/t", "", hdrs)
    seenTid: str = ""
    seenSid: str = ""
    go! {
        inboundParts := strings.Split(r2.Body, "|")
        if len(inboundParts) == 3 {
            seenTid = strings.Split(inboundParts[0], "-")[1]
            seenSid = inboundParts[2]
        }
    }
    print(f"inbound-same-trace: {seenTid == inboundTid}")
    newSpan: bool = false
    if seenSid != inboundSid and seenSid != "" {
        newSpan = true
    }
    print(f"inbound-new-span: {newSpan}")
    print(f"state-propagated: {r2.header('tracestate')}")

    srv2: Server = Server()
    tracing(srv2, false)
    srv2.get("/t", traceDump)
    r3: InjectResponse = srv2.inject("GET", "/t")
    print(f"echo-off-no-header: {r3.header('traceparent') == ''}")
}
